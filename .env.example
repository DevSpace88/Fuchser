# ============================================================================
# .env.example — template for environment variables
# ============================================================================
# Copy this file to .env and adjust the values:
#   cp .env.example .env
#
# The .env is read automatically by docker-compose.yml
# (see the `env_file:` / `environment:` entries there).
# The real values (passwords, secret key) NEVER belong in git!

# ----------------------------------------------------------------------------
# GENERAL
# ----------------------------------------------------------------------------
# Which "environment" are we running in?
#   "dev"    -> development (debug mode, lenient CORS, verbose logs)
#   "prod"   -> production  (strict, no internal details exposed outward)
#   "test"   -> tests       (dedicated test DB, deterministic)
ENVIRONMENT=dev

# ----------------------------------------------------------------------------
# POSTGRES (database)
# ----------------------------------------------------------------------------
# These variables are used equally by the HOST (host machine) and the backend
# container. Within docker-compose the DB container has the
# hostname "db" (that is the service name in the compose file).
#
# IMPORTANT for beginners: In docker-compose we use the same variable name
# twice — once for the Postgres server (the container that *provides* the DB)
# and once in the backend (which *connects* to it as a client).
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=app_db
# Hostname of the DB from the backend's point of view. In the Compose network
# the DB service is called "db". On the host machine (without Docker), enter "localhost".
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# BACKEND (FastAPI)
# ----------------------------------------------------------------------------
# From whose perspective is POSTGRES_HOST used? Inside the Docker container it
# is "db" (see above). If you start the backend locally WITHOUT Docker, set it to "localhost".
# This value also controls whether the app pings the DB at startup (lifespan).
BACKEND_PORT=8000

# SECRET_KEY used to sign the JWTs.
# Generate a real random key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without a real secret key the backend refuses to start in "prod".
SECRET_KEY=please_change_me_to_a_long_random_string

# JWT algorithm. HS256 = HMAC with a symmetric key (the same
# SECRET_KEY signs AND verifies). For distributed systems you can switch to
# RS256 (asymmetric) — see the comment in backend/app/core/security.py.
JWT_ALGORITHM=HS256

# Token lifetimes. Access tokens are SHORT (limits the damage if stolen),
# refresh tokens LONG (convenience: log in less often).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# CORS — which origins is the frontend allowed to call from?
# ----------------------------------------------------------------------------
# In development Vite runs on http://localhost:5173. The backend must
# explicitly allow this origin (otherwise the browser blocks the request).
# Specify multiple origins separated by commas.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------------------
# FRONTEND (Vite)
# ----------------------------------------------------------------------------
# Port of the Vite dev server.
FRONTEND_PORT=5173
# URL under which the backend is reachable from the browser's point of view.
# The Vite proxy forwards /api internally anyway, but for direct calls
# (e.g. Swagger /docs) you need this URL.
VITE_API_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# FIRST ADMIN USER (created automatically on first start — "seeding")
# ----------------------------------------------------------------------------
# Practical, so you can log in as admin right away.
# If left empty, no admin is created automatically.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_too

# ============================================================================
# AGENT (LangGraph "Deep Research" clone, see PLAN.md)
# ============================================================================
# API key for DeepSeek (https://platform.deepseek.com) — required for the LLM.
DEEPSEEK_API_KEY=
# Which DeepSeek model? deepseek-chat = V3 (solid tool calling).
DEEPSEEK_MODEL=deepseek-chat
# API key for Tavily (https://tavily.com) — web search, free tier ~1000 credits/month.
TAVILY_API_KEY=

# --- Alternative: Z.ai GLM Coding Plan (international API) ---
# Subscription: https://z.ai -> GLM Coding Plan; generate the key in the plan overview there.
# IMPORTANT: coding plan endpoint (api.z.ai), NOT the China address bigmodel.cn.
LLM_PROVIDER=deepseek   # "deepseek" or "glm"
GLM_API_KEY=
GLM_MODEL=glm-5.3       # or glm-5.3-flash (faster/cheaper)
#GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Redis for background tasks (worker architecture)
REDIS_URL=redis://redis:6379/0
