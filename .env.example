# ============================================================================
# .env.example — Vorlage für Umgebungsvariablen
# ============================================================================
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
#
# Die .env wird von docker-compose.yml automatisch eingelesen
# (siehe dortiges `env_file:` bzw. `environment:`).
# Die echten Werte (Passwörter, Secret-Key) gehören NIEMALS in git!

# ----------------------------------------------------------------------------
# ALLGEMEIN
# ----------------------------------------------------------------------------
# In welcher "Umgebung" laufen wir?
#   "dev"    -> Entwicklung (Debug-Modus, lockere CORS, ausführliche Logs)
#   "prod"   -> Produktion  (strikt, keine internen Details nach außen)
#   "test"   -> Tests       (eigene Test-DB, deterministisch)
ENVIRONMENT=dev

# ----------------------------------------------------------------------------
# POSTGRES (Datenbank)
# ----------------------------------------------------------------------------
# Diese Variablen nutzen WIRTE (Host-Rechner) und das Backend-Container
# gleichermaßen. Innerhalb von docker-compose hat der DB-Container den
# Hostnamen "db" (so heißt der Service in der compose-Datei).
#
# WICHTIG für Einsteiger: In docker-compose verwenden wir zweimal denselben
# Variablen-Namen — einmal für den Postgres-Server (der Container, der die DB
# *bereitstellt*) und einmal im Backend (das sich als Client *verbindet*).
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=app_db
# Hostname der DB aus Sicht des Backends. Im Compose-Netzwerk heißt der
# DB-Service "db". Auf der Wirtsmaschine (ohne Docker) trägst du "localhost" ein.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# BACKEND (FastAPI)
# ----------------------------------------------------------------------------
# Aus welcher Sicht wird POSTGRES_HOST gebraucht? Im Docker-Container ist es
# "db" (s. o.). Wenn du das Backend lokal OHNE Docker startest, setze auf "localhost".
# Dieser Wert steuert auch, ob die App die DB bei Start anpingt (Lifespan).
BACKEND_PORT=8000

# SECRET_KEY zum Signieren der JWTs.
# Erzeuge einen echten Zufallsschlüssel mit:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ohne echten Secret-Key verweigert das Backend in "prod" den Start.
SECRET_KEY=please_change_me_to_a_long_random_string

# JWT-Algorithmus. HS256 = HMAC mit symmetrischem Schlüssel (derselbe
# SECRET_KEY signiert UND verifiziert). Für verteilte Systeme kann man auf
# RS256 (asymmetrisch) umsteigen — siehe Kommentar in backend/app/core/security.py.
JWT_ALGORITHM=HS256

# Lebensdauer der Tokens. Access-Tokens sind KURZ (Sicherheit bei Diebstahl),
# Refresh-Tokens LANG (Komfort: seltener neu einloggen).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# CORS — welche Origins darf das Frontend ansprechen?
# ----------------------------------------------------------------------------
# In der Entwicklung läuft Vite auf http://localhost:5173. Das Backend muss
# dieser Origin explizit erlauben (sonst blockiert der Browser die Anfrage).
# Mehrere Origins kommasepariert angeben.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------------------
# FRONTEND (Vite)
# ----------------------------------------------------------------------------
# Port des Vite-Dev-Servers.
FRONTEND_PORT=5173
# URL, unter der das Backend aus Sicht des Browsers erreichbar ist.
# Der Vite-Proxy leitet /api anyway intern weiter, aber für direkte Aufrufe
# (z. B. Swagger /docs) brauchst du diese URL.
VITE_API_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# ERSTER ADMIN-USER (wird beim ersten Start automatisch angelegt — "Seeding")
# ----------------------------------------------------------------------------
# Praktisch, damit du dich sofort als Admin einloggen kannst.
# Bleibt leer, wird kein Admin automatisch angelegt.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_too

# ============================================================================
# AGENT (LangGraph "Deep Research"-Klon, siehe PLAN.md)
# ============================================================================
# API-Key für DeepSeek (https://platform.deepseek.com) — Pflicht fürs LLM.
DEEPSEEK_API_KEY=
# Welches DeepSeek-Modell? deepseek-chat = V3 (soltides Tool-Calling).
DEEPSEEK_MODEL=deepseek-chat
# API-Key für Tavily (https://tavily.com) — Websuche, Free Tier ~1000 Credits/Monat.
TAVILY_API_KEY=

# --- Alternative: Z.ai GLM Coding Plan (internationale API) ---
# Abo: https://z.ai -> GLM Coding Plan; Key dort im Plan-Overview erzeugen.
# WICHTIG: Coding-Plan-Endpoint (api.z.ai), NICHT die China-Adresse bigmodel.cn.
LLM_PROVIDER=deepseek   # "deepseek" oder "glm"
GLM_API_KEY=
GLM_MODEL=glm-5.3       # oder glm-5.3-flash (schneller/günstiger)
#GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Redis für Background-Tasks (Worker-Architektur)
REDIS_URL=redis://redis:6379/0
