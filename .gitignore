# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# uv (Python-Paketmanager, das wir verwenden)
# uv.lock NICHT ignorieren — er speichert die exakten Versionen und gehört in git!

# ============================================================================
