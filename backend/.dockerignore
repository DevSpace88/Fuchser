# What should NOT go into the Docker build context (saves time + bandwidth).
# IMPORTANT: uv.lock and pyproject.toml must STAY IN, otherwise
# `uv sync --frozen` fails!

# Virtual environment (created locally) — would push hundreds of MB into the context.
.venv/

# Cache directories
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# IDE
.idea/
.vscode/

# Env (never bake secrets into the image!)
.env
.env.*

# Git
.git/
.gitignore
